# Host-process default. Docker Compose overrides this with its PostgreSQL URL.
SAT_SIM_DATABASE_URL=sqlite+aiosqlite:///./runtime-data/sat-simulation.db
SAT_SIM_DATA_DIR=/data
SAT_SIM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAT_SIM_GROUND_DOWNLINK_HOST=ground-api
SAT_SIM_GROUND_DOWNLINK_PORT=9201
SAT_SIM_PLATFORM_UPLINK_HOST=platform-node
SAT_SIM_PLATFORM_UPLINK_PORT=9200
SAT_SIM_GPU_GTX_HOST=gpu-node
SAT_SIM_GPU_GTX_PORT=9101
SAT_SIM_PLATFORM_HTTP_URL=http://platform-node:8001
# Future providers; values are not exposed through the public API.
SAT_SIM_YOLO_API_URL=
SAT_SIM_LLM_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000/api
