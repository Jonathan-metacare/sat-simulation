# Host-process defaults. Docker Compose overrides these with its service network.
SAT_SIM_DATABASE_URL=sqlite+aiosqlite:///./runtime-data/sat-simulation.db
SAT_SIM_DATA_DIR=runtime-data
SAT_SIM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAT_SIM_GROUND_DOWNLINK_HOST=127.0.0.1
SAT_SIM_GROUND_DOWNLINK_PORT=9201
SAT_SIM_PLATFORM_UPLINK_HOST=127.0.0.1
SAT_SIM_PLATFORM_UPLINK_PORT=9200
SAT_SIM_GPU_GTX_HOST=127.0.0.1
SAT_SIM_GPU_GTX_PORT=9101
SAT_SIM_PLATFORM_GTX_RESULT_HOST=127.0.0.1
SAT_SIM_PLATFORM_GTX_RESULT_PORT=9102
SAT_SIM_PLATFORM_HTTP_URL=http://127.0.0.1:8001
SAT_SIM_GPU_HTTP_URL=http://127.0.0.1:8002
# Future providers; values are not exposed through the public API.
SAT_SIM_YOLO_API_URL=
SAT_SIM_YOLO_MODEL=default
SAT_SIM_YOLO_API_KEY=
SAT_SIM_LLM_API_URL=
SAT_SIM_LLM_MODEL=gpt-4.1-mini
SAT_SIM_LLM_API_KEY=
SAT_SIM_PROVIDER_TIMEOUT_SECONDS=30
SAT_SIM_STAGE_ANIMATION_SECONDS=8
NEXT_PUBLIC_API_URL=http://localhost:8000/api
