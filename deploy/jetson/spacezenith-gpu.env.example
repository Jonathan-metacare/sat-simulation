# Copy next to docker-compose.yml as spacezenith-gpu.env. Do not commit secrets.
# The GPU API runs with host networking so it can reach host-managed Ollama.
SAT_SIM_HOST=0.0.0.0
SAT_SIM_GPU_API_PORT=8002
SAT_SIM_GPU_GTX_PORT=9101
SAT_SIM_DATA_DIR=/var/lib/spacezenith-sim
SAT_SIM_OCI_RUNTIME=docker
SAT_SIM_PROCESSOR_IMAGE=spacezenith/processor-python:3.12
# Ollama is deliberately local to the Jetson.
SAT_SIM_LLM_API_URL=http://127.0.0.1:11434
SAT_SIM_LLM_MODEL=qwen3-vl:8b
SAT_SIM_LLM_REQUIRE_VISION=true
SAT_SIM_PROVIDER_TIMEOUT_SECONDS=120
# Leave this empty: GPU reports processor execution through GTX ACK, never
# directly to the Mac Ground API.
SAT_SIM_GROUND_HTTP_URL=
# The Compose variable selects the loaded GPU API image.
SAT_SIM_GPU_API_IMAGE=spacezenith/sim-gpu-api:0.1.1
