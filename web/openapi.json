            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Target Latitude",
            "default": 39.9042
          },
          "target_longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Target Longitude",
            "default": 116.4074
