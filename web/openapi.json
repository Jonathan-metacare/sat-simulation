            "default": "1 55244U 23006C   26126.66766851  .00004587  00000-0  24048-3 0  9998"
          },
          "tle_line2": {
            "type": "string",
            "title": "Tle Line2",
            "default": "2 55244  43.1978 352.6432 0015896 112.1710 248.0829 15.16807012183579"
          },
          "satellite_name": {
            "type": "string",
            "title": "Satellite Name",
            "default": "SIM-OPTICAL-01"
          },
          "ground_station_name": {
            "type": "string",
            "title": "Ground Station Name",
            "default": "GS-DEMO-BEIJING"
          },
          "ground_station_latitude": {
            "type": "number",
            "title": "Ground Station Latitude",
            "default": 39.9042
          },
          "ground_station_longitude": {
            "type": "number",
            "title": "Ground Station Longitude",
            "default": 116.4074
          },
          "ground_station_altitude_m": {
            "type": "number",
            "title": "Ground Station Altitude M",
            "default": 50.0
          },
          "deterministic_contact": {
            "type": "boolean",
            "title": "Deterministic Contact",
            "default": true
          },
          "scene_id": {
            "type": "string",
            "title": "Scene Id",
            "default": "demo-optical-scene"
          }
        },
        "type": "object",
        "title": "ScenarioConfig"
      },
      "ScenarioControl": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ClockAction"
          },
          "rate": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  1,
                  10,
                  100
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "step_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Step Seconds",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ScenarioControl"
      },
      "TransferRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "mission_id": {
            "type": "string",
