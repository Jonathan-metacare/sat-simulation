            "minimum": 0.0,
            "title": "Drop Rate",
            "default": 0
          },
          "corrupt_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Corrupt Rate",
            "default": 0
          },
          "duplicate_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Duplicate Rate",
            "default": 0
          },
          "reorder": {
            "type": "boolean",
            "title": "Reorder",
            "default": false
          },
          "disconnected": {
            "type": "boolean",
            "title": "Disconnected",
            "default": false
          },
          "extra_latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Extra Latency Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "link"
        ],
        "title": "FaultRule"
      },
