{
  "name": "spacezenith-sim",
  "version": "0.1.1",
  "description": "SpaceZenith-Sim satellite onboard AI software-in-the-loop desktop dashboard",
  "author": "SpaceZenith",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "dev": "pnpm copy:cesium && next dev",
    "build": "pnpm copy:cesium && next build && node desktop/scripts/materialize-standalone.mjs",
    "start": "next start",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:python": "node desktop/scripts/build-python.mjs",
    "desktop:python:win": "node desktop/scripts/build-python.mjs --platform=win32",
    "desktop:dist": "pnpm build && pnpm desktop:python && electron-builder --config desktop/electron-builder.yml --mac dmg --arm64",
    "desktop:dist:win": "pnpm build && pnpm desktop:python:win && electron-builder --config desktop/electron-builder.yml --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:api": "../.venv/bin/python ../scripts/export_openapi.py && openapi-typescript openapi.json -o src/lib/openapi.generated.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cesium": "^1.132.0",
    "lucide-react": "^0.539.0",
    "next": "^15.4.10",
    "next-intl": "^4.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.10",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  }
}
